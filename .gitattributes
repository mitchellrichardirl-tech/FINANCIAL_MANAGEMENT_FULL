# Default to LF for all files
* text=auto eol=lf

# Explicitly set certain files
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# Keep Windows line endings for Windows-specific files
*.bat text eol=crlf
*.ps1 text eol=crlf