# development | test | production
APP_ENV=development

# Where the database and uploads live. Default: backend/data-dev in this checkout.
# Leave unset in development so each worktree stays separate.
# DATA_DIR=

# Secrets
GEMINI_API_KEY=

# Services
LLM_GATEWAY_URL=http://llm_gateway-api-1:8000

# database
PDOC_GENERATING=1

# api
WERKZEUG_RUN_MAIN=1
PORT=5000

# Receipt streaming (seconds). Keep HEARTBEAT well below the frontend idle timeout (30s).
# RECEIPT_TASK_TIMEOUT=180
# RECEIPT_STREAM_TIMEOUT=900
# RECEIPT_STREAM_HEARTBEAT=10