DATABASE_PATH=</path/to/database/using/linux/norms.db>
UPLOAD_FOLDER=</path/to/folder/for/uploaded/receipts/using/linux/norms.db>
LLM_GATEWAY_API_KEY=<key for local llm gateway>
GEMINI_API_KEY=<key for gemini api for receipt key value extraction>
RECEIPT_MATCH_DATE_TOLERANCE_DAYS=5     # candidate window either side of receipt date
RECEIPT_MATCH_AMOUNT_TOLERANCE=0.01     # absolute amount difference tolerated
RECEIPT_AUTO_LINK_THRESHOLD=0.98        # Phase 3: score at/above which links are made automatically; 1.01 disables