{
  "name": "Finance App",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "DATABASE_PATH": "${containerWorkspaceFolder}/backend/data-dev/financial_data.db",
    "UPLOAD_FOLDER": "${containerWorkspaceFolder}/backend/data-dev/uploads"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.datawrangler",
        "mechatroner.rainbow-csv",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
        "python.analysis.exclude": [
          "**/node_modules",
          "**/.venv",
          "**/venv",
          "**/__pycache__",
          "**/dist",
          "**/build"
        ],
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.venv/**": true,
          "**/venv/**": true,
          "**/__pycache__/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/dist/**": true,
          "**/build/**": true
        },
        "python.analysis.typeCheckingMode": "basic",
        "python.formatting.provider": "none",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  },
  "forwardPorts": [5000, 5173, 8888],
  "mounts": [
    "source=C:/Users/User/OneDrive/Receipts,target=/workspace/receipts,type=bind"
  ]
}